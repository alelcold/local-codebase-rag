# nginx config template. At container start the official nginx image runs
# envsubst on /etc/nginx/templates/*.template and writes the result to
# /etc/nginx/conf.d/. Only variables matching NGINX_ENVSUBST_FILTER (^PROXY_)
# are substituted, so nginx's own $host etc. are left alone.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # /api/* -> FastAPI backend (prefix stripped). Local LLM answers can take
    # minutes (first call loads the model; CPU-only machines are slow), hence
    # long timeouts. Set PROXY_READ_TIMEOUT / PROXY_SEND_TIMEOUT (seconds) in
    # .env; defaults live in the Dockerfile. See ADR 0009.
    location /api/ {
        proxy_pass http://backend:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_send_timeout ${PROXY_SEND_TIMEOUT}s;
        proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
        client_max_body_size 1m;
    }

    # Streaming answers (Server-Sent Events, ADR 0010). Exact match, so it wins
    # over /api/ above. By default nginx buffers upstream responses and would
    # hold the tokens back until a buffer fills or the answer ends; buffering
    # off forwards each event as soon as the backend writes it. The backend
    # also sends "X-Accel-Buffering: no"; this keeps working without it.
    location = /api/query/stream {
        proxy_pass http://backend:8000/query/stream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_send_timeout ${PROXY_SEND_TIMEOUT}s;
        # Between two reads, not for the whole answer: heartbeats and tokens
        # reset it, so a long answer is fine as long as data keeps flowing.
        proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
        client_max_body_size 1m;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
