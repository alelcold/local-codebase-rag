        "src/game/GameState.ts"
      ],
      "expect_no_answer": false,
      "answer": "### 高分存取位置\n\n[1] src/game/GameState.ts:14-14 — 程式碼\n```typescript\nexport const HIGH_SCORE_KEY = \"starlight-courier.highScore\";\n```\n\n### 最高分存取方式\n\n[2] src/game/Game.ts:145-151 (method Game.gameOver) — 程式碼\n```typescript\n  private gameOver(): void {\n    this.sound.play(\"gameOver\");\n    const best = Math.max(this.score.score, this.ui.get().highScore);\n    localStorage.setItem(HIGH_SCORE_KEY, String(best));\n    this.ui.set({ highScore: best });\n    this.setPhase(\"gameOver\");\n  }\n```\n\n[3] src/game/Game.ts:37-49 (method Game.constructor) — 程式碼\n```typescript\n  constructor(private ctx: CanvasRenderingContext2D) {\n    this.input = new InputManager();\n    this.ui = createUiStore({\n      phase: \"title\",\n      score: 0,\n      lives: this.player.lives,\n      level: 1,\n      levelName: getLevel(0).name,\n      comboMultiplier: 1,\n      dashReady: true,\n      highScore: Number(localStorage.getItem(HIGH_SCORE_KEY) ?? 0),\n    });\n  }\n```\n\n### 高分存取流程\n\n1. 在 `Game` 的 `constructor` 方法中，初始化 `ui` 時，從 `localStorage` 中讀取 `HIGH_SCORE_KEY` 的值，並設定到 `ui` 的 `highScore` 屬性中。\n2. 在 `gameOver` 方法中，計算當前最高分（`best`），並更新 `localStorage` 中的 `HIGH_SCORE_KEY` 值。\n3. 更新 `ui` 中的 `highScore` 屬性，並設置遊戲狀態為 `gameOver`。",
