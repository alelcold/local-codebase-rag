# GitHub Codespaces 用的 .env 範本（Linux、只有 CPU）。
# .devcontainer/post-create.sh 會在沒有 .env 時，把這個檔案複製成 .env。
# 沒寫在這裡的項目使用預設值，完整清單與說明見 .env.example。

# 要索引的專案：附帶的範例專案。
PROJECT_PATH=./examples/sample-game-frontend

# Ollama 直接在 codespace 裡執行（post-start.sh 以 OLLAMA_HOST=0.0.0.0 啟動），
# 容器透過 host.docker.internal（docker-compose.codespaces.yml 的 host-gateway）連過去。
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 沒有 GPU：用 3B 模型。14B 在 CPU 上一次回答要好幾分鐘。
LLM_MODEL=qwen2.5-coder:3b
EMBED_MODEL=nomic-embed-text
# 4 段程式碼約 4k tokens，8192 足夠，且比預設 16384 省記憶體。
LLM_NUM_CTX=8192

# 給模型看的片段數。越少，CPU 上的首字延遲越短（介面上仍可調整）。
TOP_K=4

# 逾時（秒）。nginx 比後端稍長，讓後端先逾時並回傳具體原因（ADR 0009）。
# 串流回應（ADR 0010）每 STREAM_HEARTBEAT_SECONDS 秒至少送一次資料，讓 Codespaces 轉發看到連線仍在使用。
LLM_REQUEST_TIMEOUT=300
EMBED_REQUEST_TIMEOUT=300
PROXY_READ_TIMEOUT=330
PROXY_SEND_TIMEOUT=330
STREAM_HEARTBEAT_SECONDS=10

# 檢索設定（ADR 0013、0018）。這個範本採用 C 組：只開分類取回，其餘維持關閉。
# 依據：docs/evaluation/ 的 A～J 組實驗（ADR 0018）。.env.example（Mac、14B）沒有跟著改，要等 scripts/benchmark-mac.sh 實測。
# 已經有 .env 的 codespace 不會被覆蓋（post-create.sh）：要套用請自行加入下面兩行，再 docker compose up -d backend（不需重新索引）。
# 分類取回：文件最多 DOC_TOP_K 段，其餘給程式碼（不需重新索引）。
SPLIT_RETRIEVAL=true
DOC_TOP_K=1
# 提示版本：v2、v3 都沒有採用（ADR 0016、0018）。
PROMPT_VARIANT=v1
# HYBRID_SEARCH=true            # 向量 + BM25 + 識別字定義比對，RRF 合併（不需重新索引）；未採用
# CHUNK_METADATA=true           # metadata 放進 embedding（./scripts/index.sh 會自動全量重建）；未採用
#
# 防幻覺開關（ADR 0014、0015），維持關閉，未採用。見實驗計畫的 G、H、I 組。
# SCORE_THRESHOLD=              # 由 scripts/calibrate_threshold.py 決定，不要用通用的 0.70
# RERANK=true                   # 需先 INSTALL_RERANK=true docker compose build backend（映像檔多約 1.5 GB）
# RERANK_CANDIDATES=10
# RERANK_TOP_N=4                # 實驗時設為與 TOP_K 相同，只比較「選哪些片段」
