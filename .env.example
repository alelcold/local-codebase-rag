# 複製成 .env 後依需求修改：cp .env.example .env
# 所有項目都有預設值；沒寫在 .env 的項目會使用這裡列出的預設值。

# ─── 要索引的專案 ───────────────────────────────────────────────
# 主機（Mac）上的專案路徑，會以「唯讀」方式掛載到 backend 容器的 /codebase。
# 可用絕對路徑或相對於本 repo 的路徑。預設是附帶的範例專案。
PROJECT_PATH=./examples/sample-game-frontend

# ─── Ollama（直接安裝在 macOS 上，不在 Docker 內）────────────────
# 容器透過這個位址呼叫 Mac 上的 Ollama。Docker Desktop 會自動解析 host.docker.internal。
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 回答問題用的 LLM。32GB 的 M2 建議 qwen2.5-coder:14b；想更快可改 qwen2.5-coder:7b。
LLM_MODEL=qwen2.5-coder:14b
# 生成溫度，越低回答越穩定（0–1）。
LLM_TEMPERATURE=0.1
# 傳給 Ollama 的 num_ctx（上下文長度，tokens）。Ollama 預設很小，太小會截斷引用的程式碼。
# 14b + 16384 約佔 12GB 統一記憶體；記憶體吃緊可降到 8192。
LLM_NUM_CTX=16384
# 單次 LLM 請求逾時秒數（第一次查詢要載入模型，會比較久）。
LLM_REQUEST_TIMEOUT=600
# 模型閒置多久後從記憶體卸載（Ollama keep_alive 格式，例如 5m、30m、1h、-1 代表永不卸載）。
OLLAMA_KEEP_ALIVE=30m

# 向量化（embedding）模型。更換後會自動使用新的 Qdrant collection，需要重新索引。
EMBED_MODEL=nomic-embed-text
# 每批送給 Ollama 的片段數。
EMBED_BATCH_SIZE=16
# Embedding 前綴。留空 = 自動：nomic-embed-text 使用 "search_query: " / "search_document: "，
# 其他模型不加前綴。只有在模型文件要求特定前綴時才需要設定。
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=

# ─── Qdrant ─────────────────────────────────────────────────────
# Collection 名稱。留空 = 依 EMBED_MODEL 自動命名（例如 codebase_nomic_embed_text）。
# 同一台機器要索引多個專案時，請為每個專案設定不同名稱。
QDRANT_COLLECTION=

# ─── 索引規則 ───────────────────────────────────────────────────
# 要索引的副檔名（逗號分隔）。.ts/.tsx/.js/.jsx/.mjs/.cjs 依函式/class 切塊，.md 依標題切塊，
# 其他副檔名（例如 .vue、.css、.json）會以固定行數視窗切塊。
INDEX_EXTENSIONS=.ts,.tsx,.js,.jsx,.mjs,.cjs,.md
# 略過的資料夾名稱（任何層級）。
EXCLUDE_DIRS=node_modules,.git,dist,build,out,coverage,.next,.nuxt,.turbo,.cache,.vite,vendor
# 略過的檔名樣式（glob，比對檔名）。
EXCLUDE_PATTERNS=*.min.js,*.bundle.js,*.map,*.d.ts,package-lock.json
# 超過這個大小（bytes）的檔案會略過，通常是打包產物或自動產生的資料。
MAX_FILE_BYTES=500000
# 每個片段的最大字元數；超過時 class 會再依 method 切開，其他則依行數切開。修改後會自動重新索引。
CHUNK_MAX_CHARS=3000

# ─── 查詢 ───────────────────────────────────────────────────────
# 每次查詢預設取回的片段數（前端可另外調整）。
TOP_K=8

# ─── 連接埠與存取 ───────────────────────────────────────────────
# 前端網址：http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080
# 前端綁定的網卡。127.0.0.1 = 只有本機可用；改成 0.0.0.0 讓區網內的團隊成員連線（本系統沒有登入機制，請只在可信任的網路使用）。
FRONTEND_BIND=127.0.0.1
# 後端 API 與 Qdrant 只綁定 127.0.0.1，供本機腳本與除錯使用。
BACKEND_PORT=8000
QDRANT_PORT=6333
# 後端允許的 CORS 來源（逗號分隔）。透過前端的 /api 代理存取時不需要調整。
CORS_ORIGINS=*
