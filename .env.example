# 複製成 .env 後依需求修改：cp .env.example .env
# 所有項目都有預設值；沒寫在 .env 的項目會使用這裡列出的預設值。

# ─── 要索引的專案 ───────────────────────────────────────────────
# 主機（Mac）上的專案路徑，會以「唯讀」方式掛載到 backend 容器的 /codebase。
# 可用絕對路徑或相對於本 repo 的路徑。預設是附帶的範例專案。
PROJECT_PATH=./examples/sample-game-frontend

# ─── Ollama（直接安裝在 macOS 上，不在 Docker 內）────────────────
# 容器透過這個位址呼叫 Mac 上的 Ollama。Docker Desktop 會自動解析 host.docker.internal。
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 回答問題用的 LLM。32GB 的 M2 建議 qwen2.5-coder:14b；想更快可改 qwen2.5-coder:7b。
LLM_MODEL=qwen2.5-coder:14b
# 生成溫度，越低回答越穩定（0–1）。
LLM_TEMPERATURE=0.1
# 傳給 Ollama 的 num_ctx（上下文長度，tokens）。Ollama 預設很小，太小會截斷引用的程式碼。
# 14b + 16384 約佔 12GB 統一記憶體；記憶體吃緊可降到 8192。
LLM_NUM_CTX=16384
# 模型閒置多久後從記憶體卸載（Ollama keep_alive 格式，例如 5m、30m、1h、-1 代表永不卸載）。
OLLAMA_KEEP_ALIVE=30m

# 向量化（embedding）模型。更換後會自動使用新的 Qdrant collection，需要重新索引。
EMBED_MODEL=nomic-embed-text
# 每批送給 Ollama 的片段數。
EMBED_BATCH_SIZE=16
# Embedding 前綴。留空 = 自動：nomic-embed-text 使用 "search_query: " / "search_document: "，
# 其他模型不加前綴。只有在模型文件要求特定前綴時才需要設定。
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=

# ─── 逾時（秒）─────────────────────────────────────────────────
# 一次查詢會經過：瀏覽器 →（Codespaces 等轉發）→ nginx → 後端 → Ollama，每一段都有自己的逾時。
# 預設 300 秒：只有 CPU 的環境（例如 Codespaces + 3b 模型）一次查詢約 1.5～2 分鐘，留有餘裕。
# 更慢的環境請一起調高；建議 PROXY_READ_TIMEOUT 比 LLM_REQUEST_TIMEOUT 稍大（例如 330 / 300），
# 讓後端先逾時並回傳具體原因，而不是由 nginx 回傳籠統的 504。詳見 docs/decisions/0009-timeout-settings.md。
#
# 後端等待 Ollama 生成回答的上限（第一次查詢要載入模型，會比較久）。
LLM_REQUEST_TIMEOUT=300
# 後端等待 Ollama 產生向量（embedding，索引與查詢都會用到）的上限。
EMBED_REQUEST_TIMEOUT=300
# 前端 nginx 代理 /api 時，等待後端回應／傳送請求給後端的上限。只要重新啟動容器即可生效，不需重新 build。
# 注意：Codespaces 連接埠轉發等外部代理有自己的上限，調高這裡的值無法繞過。
PROXY_READ_TIMEOUT=300
PROXY_SEND_TIMEOUT=300

# 串流查詢（/query/stream）在沒有其他資料送出時，每隔幾秒送一次 heartbeat，
# 讓「連線閒置太久就切斷」的代理（例如 Codespaces 連接埠轉發）看到連線仍有資料流動。
# 見 docs/decisions/0010-streaming-responses.md。
STREAM_HEARTBEAT_SECONDS=10

# ─── Qdrant ─────────────────────────────────────────────────────
# Collection 名稱。留空 = 依 EMBED_MODEL 自動命名（例如 codebase_nomic_embed_text）。
# 同一台機器要索引多個專案時，請為每個專案設定不同名稱。
QDRANT_COLLECTION=

# ─── 索引規則 ───────────────────────────────────────────────────
# 要索引的副檔名（逗號分隔）。.ts/.tsx/.js/.jsx/.mjs/.cjs 依函式/class 切塊，.md 依標題切塊，
# 其他副檔名（例如 .vue、.css、.json）會以固定行數視窗切塊。
INDEX_EXTENSIONS=.ts,.tsx,.js,.jsx,.mjs,.cjs,.md
# 略過的資料夾名稱（任何層級）。
EXCLUDE_DIRS=node_modules,.git,dist,build,out,coverage,.next,.nuxt,.turbo,.cache,.vite,vendor
# 略過的檔名樣式（glob，比對檔名）。
EXCLUDE_PATTERNS=*.min.js,*.bundle.js,*.map,*.d.ts,package-lock.json
# 超過這個大小（bytes）的檔案會略過，通常是打包產物或自動產生的資料。
MAX_FILE_BYTES=500000
# 每個片段的最大字元數；超過時 class 會再依 method 切開，其他則依行數切開。修改後會自動重新索引。
CHUNK_MAX_CHARS=3000
# 把 metadata（檔案路徑、程式碼／文件類型、函式／class 名稱、片段中定義與 export 的常數／函式名稱）
# 一併放進 embedding 的內容，讓「INVINCIBLE_MS 在哪裡設定」能對到宣告它的程式碼片段。
# 會改變 embedding 內容：切換後執行 ./scripts/index.sh，索引器會偵測到設定改變並自動全量重建。
# 見 docs/decisions/0013-hybrid-retrieval-and-split-retrieval.md。
CHUNK_METADATA=false

# ─── 查詢 ───────────────────────────────────────────────────────
# 每次查詢預設取回的片段數（前端可另外調整）。
TOP_K=8

# 以下是檢索改善的開關（ADR 0013），全部關閉 = 原本只用向量檢索的基準線。
# 只影響查詢，切換後重新啟動 backend 即可（docker compose up -d backend），不需重新索引。
# 逐項比較的方法見 docs/evaluation/experiment-plan-retrieval.md。
#
# 混合檢索：向量檢索 + BM25 關鍵字檢索 + 問題中識別字（例如 INVINCIBLE_MS、ScoreSystem）的定義比對，
# 以 RRF（Reciprocal Rank Fusion）合併排序。
HYBRID_SEARCH=false
# RRF 的平滑常數 k：每份排名第 r 名得 1/(k+r) 分。越小越偏重各清單的第一名。
RRF_K=60
# 每種檢索在合併／分類前先取回的候選數。
RETRIEVAL_CANDIDATES=30
# 程式碼與文件分開取回：文件最多 DOC_TOP_K 段，其餘 TOP_K − DOC_TOP_K 段給程式碼（程式碼排在前面）。
# 某一類不夠時，名額讓給另一類。
SPLIT_RETRIEVAL=false
DOC_TOP_K=1
# 系統提示版本：v1 = 原本（用問題的語言回答）；v2 = 一律繁體中文，並先說明程式碼位置（檔案與行號）。
PROMPT_VARIANT=v1

# ─── 防幻覺開關（ADR 0014、0015）─────────────────────────────────
# 同樣只影響查詢，切換後 docker compose up -d backend 即可。逐項比較見實驗計畫的 G、H、I 組。
#
# 相似度門檻：向量檢索那一路 cosine 相似度低於此值的片段，在 RRF 合併之前就丟掉。
# 全部被丟掉時不呼叫 LLM，直接回答「在索引的專案中找不到相關內容」。
# 留空 = 不過濾（預設）。沒有通用值：請用 python3 scripts/calibrate_threshold.py 從評估結果決定，
# 不要直接套 0.70（nomic-embed-text 實測中，一個相關的 Markdown 片段只有 0.60 分）。換 embedding 模型就要重新校準。
# 混合檢索開啟時，問題中精確識別字（例如 INVINCIBLE_MS）的定義片段不受門檻影響。
SCORE_THRESHOLD=
#
# Rerank：先依上面的設定取回 RERANK_CANDIDATES 段候選，交叉編碼器（cross-encoder）重新排序後，
# 取 RERANK_TOP_N 段送進 LLM（此時 RERANK_TOP_N 取代 TOP_K 作為預設片段數）。
# 需要以 INSTALL_RERANK=true 建置 backend 映像檔（多約 1.5 GB）：INSTALL_RERANK=true docker compose build backend
# 模型在第一次查詢時才下載並載入，存在 reranker_models volume；RERANK=false 時完全不載入。
RERANK=false
# 預設 bge-reranker-base（中英文，約 1 GB）：CPU 上 10 段約 4 秒。BAAI/bge-reranker-v2-m3 較準但約 12 秒，見 ADR 0015。
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_CANDIDATES=10
RERANK_TOP_N=3
# 每組（問題, 片段）送進交叉編碼器的 token 上限；越大越慢。
RERANK_MAX_LENGTH=512
# 建置參數：true = backend 映像檔安裝 torch（CPU 版）與 sentence-transformers。
INSTALL_RERANK=false

# ─── 連接埠與存取 ───────────────────────────────────────────────
# 前端網址：http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080
# 前端綁定的網卡。127.0.0.1 = 只有本機可用；改成 0.0.0.0 讓區網內的團隊成員連線（本系統沒有登入機制，請只在可信任的網路使用）。
FRONTEND_BIND=127.0.0.1
# 後端 API 與 Qdrant 只綁定 127.0.0.1，供本機腳本與除錯使用。
BACKEND_PORT=8000
QDRANT_PORT=6333
# 後端允許的 CORS 來源（逗號分隔）。透過前端的 /api 代理存取時不需要調整。
CORS_ORIGINS=*
